# Copy this file to a private environment file and fill in real values.
# Never commit real credentials to this public repository.
NAVER_API_HUB_CLIENT_ID=
NAVER_API_HUB_CLIENT_SECRET=
# Optional override for tests or proxy deployments. HTTPS is required outside loopback.
# NAVER_API_BASE_URL=https://naverapihub.apigw.ntruss.com
NAVER_MCP_HOST=127.0.0.1
NAVER_MCP_PORT=8100
NAVER_MCP_PATH=/mcp
# Supported values: stdio, http, sse, streamable-http
NAVER_MCP_TRANSPORT=streamable-http
# Non-loopback HTTP binding requires fastmcp-auth or trusted-network.
NAVER_MCP_REMOTE_ACCESS=disabled
# JWT settings required when NAVER_MCP_REMOTE_ACCESS=fastmcp-auth.
# NAVER_MCP_AUTH_JWKS_URI=https://auth.example.com/.well-known/jwks.json
# NAVER_MCP_AUTH_ISSUER=https://auth.example.com
# NAVER_MCP_AUTH_AUDIENCE=naver-mcp
NAVER_HTTP_TIMEOUT_SEC=8.0
# Non-negative integer. Zero disables all Search API tool caching.
NAVER_CACHE_TTL_SEC=300
